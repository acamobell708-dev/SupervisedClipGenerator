# Copy this file to .env (optional). No YouTube Data API / OpenAI key is needed for basic operation.
PORT=3000
YT_DLP_PATH=yt-dlp
# Optional path to ffmpeg.exe for the Download test clip button.
FFMPEG_PATH=ffmpeg
YT_DLP_TIMEOUT_MS=60000
# Optional: fetch public comments via official YouTube Data API v3 (any public creator's videos).
# More predictable than the keyless yt-dlp comments fallback. No channel OAuth required.
YOUTUBE_API_KEY=
# Limits public comment sampling. Must be between 10 and 200.
COMMENT_SAMPLE_LIMIT=100
# OpenAI use is NOT implemented in MVP. Future calls must stay below 50,000 total tokens per run.
